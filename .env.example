# מתוך Supabase ← Project Settings ← API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# צד שרת בלבד – לא להעלות לגיט ולא לשתף
# Supabase ← Project Settings ← API Keys ← Secret key (לכתיבת הטרנדים השבועיים)
SUPABASE_SECRET_KEY=sb_secret_xxx
# טרנדים שבועיים: מפתח OpenAI (platform.openai.com ← API keys), או לחלופין ANTHROPIC_API_KEY
OPENAI_API_KEY=sk-xxx
# מחרוזת אקראית ארוכה; Vercel שולח אותה בקריאות ה-cron
CRON_SECRET=

# התראות Push – יוצרים פעם אחת: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# חיבור Meta (Instagram + Facebook) – developers.facebook.com ← האפליקציה ← App settings ← Basic
META_APP_ID=
META_APP_SECRET=
# אם באפליקציה יש Facebook Login for Business עם Configuration – ה-ID שלה (אחרת להשאיר ריק)
META_CONFIG_ID=
# מפתח הצפנה להרשאות של החיבורים: openssl rand -base64 32
INTEGRATIONS_KEY=
